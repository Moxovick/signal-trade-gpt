# --- Database (Postgres) ---
# DATABASE_URL: pooled connection (use Supabase Connection Pooler URI on port 6543).
# DIRECT_URL:   direct connection used by `prisma migrate` / `prisma db push`
#               (use Supabase Direct Connection URI on port 5432).
# Locally, both can point to the same Postgres.
DATABASE_URL="postgresql://postgres:password@localhost:5432/spacesignal?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/spacesignal?schema=public"
SHADOW_DATABASE_URL="postgresql://postgres:password@localhost:5432/spacesignal_shadow?schema=public"

# --- NextAuth ---
AUTH_SECRET="change-me-to-a-random-32-char-secret"
NEXTAUTH_URL="https://spacesignal.net"

# --- Site URL (used by TMA, referrals, etc.) ---
NEXT_PUBLIC_APP_URL="https://spacesignal.net"
NEXT_PUBLIC_SITE_URL="https://spacesignal.net"

# --- Telegram (public) ---
# Bot username for the Telegram Login Widget.
NEXT_PUBLIC_TELEGRAM_LOGIN_BOT="my_bot_username"
NEXT_PUBLIC_BOT_USERNAME="my_bot_username"
NEXT_PUBLIC_BOT_URL="https://t.me/my_bot_username"

# --- Telegram (server) ---
# Bot token used to verify Telegram Login Widget signatures.
TELEGRAM_LOGIN_BOT_TOKEN=""

# --- PocketOption ---
# Public affiliate/referral URL shown in client-side UI (TMA and web).
# Must be NEXT_PUBLIC_ so it is available in "use client" components.
# Falls back to https://pocketoption.com/ when not set.
NEXT_PUBLIC_PO_AFFILIATE_URL="https://po-ru4.click/register?utm_campaign=825519&utm_source=affiliate&utm_medium=sr&a=Be8CXM52oc4EOp&al=1769855&ac=signal&cid=960046&code=WELCOME50"
# Shared secret for authenticating incoming postbacks (?secret= query param).
POCKETOPTION_POSTBACK_SECRET=""
# Affiliate API credentials (for manual trader ID verification).
# Get from https://pocketpartners.com → API section.
POCKETOPTION_API_TOKEN=""
POCKETOPTION_PARTNER_ID=""

# --- Bot sync ---
# Shared secret the bot uses on the X-Bot-Secret header when polling
# GET /api/bot/sync. Must match BOT_SYNC_SECRET in bot/.env.
BOT_SYNC_SECRET=""

# --- Market data ---
# TwelveData API key for FX/commodity/stock candles. Leave blank to fall back
# to synthetic data.
TWELVEDATA_API_KEY=""

# --- Optional ---
# Chipa API key for real candle data on the live chart. Leave blank to use
# deterministic synthetic candles (good enough for dev/staging).
CHIPA_API_KEY=""
